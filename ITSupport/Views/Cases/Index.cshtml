@model List<ITSupport.Models.CaseViewModel>
@{
    Layout = null;
    ViewBag.Title = "Cases";
    var statuses = ViewBag.Statuses as List<ITSupport.Models.CaseStatus>;
    int? activeStatus = ViewBag.StatusId as int?;
    string search = ViewBag.Search as string;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>IT Support — Cases</title>
    @Styles.Render("~/Content/css")
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #f0f2f5;
            display: flex;
            min-height: 100vh;
            color: #333;
        }

        /* Sidebar */
        .sidebar {
            width: 240px;
            min-height: 100vh;
            background: linear-gradient(180deg,#0f3460 0%,#533483 100%);
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 100;
        }

        .sidebar-brand {
            padding: 1.5rem 1.25rem;
            border-bottom: 1px solid rgba(255,255,255,.1);
        }

            .sidebar-brand .brand-icon {
                width: 40px;
                height: 40px;
                background: rgba(255,255,255,.15);
                border-radius: 10px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 18px;
                margin-right: .5rem;
                vertical-align: middle;
            }

            .sidebar-brand span {
                color: #fff;
                font-size: 1rem;
                font-weight: 700;
                vertical-align: middle;
            }

        .sidebar-nav {
            flex: 1;
            padding: 1rem 0;
            list-style: none;
        }

        .nav-section-label {
            padding: .75rem 1.25rem .35rem;
            font-size: .68rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: rgba(255,255,255,.4);
        }

        .sidebar-nav a {
            display: flex;
            align-items: center;
            gap: .75rem;
            padding: .65rem 1.25rem;
            color: rgba(255,255,255,.75);
            text-decoration: none;
            font-size: .88rem;
            font-weight: 500;
            border-left: 3px solid transparent;
            transition: all .2s;
        }

            .sidebar-nav a:hover, .sidebar-nav a.active {
                background: rgba(255,255,255,.1);
                color: #fff;
                border-left-color: #e94560;
            }

        .nav-icon {
            font-size: 16px;
            width: 20px;
            text-align: center;
        }

        .sidebar-footer {
            padding: 1rem 1.25rem;
            border-top: 1px solid rgba(255,255,255,.1);
        }

        .user-pill {
            display: flex;
            align-items: center;
            gap: .65rem;
        }

        .user-avatar {
            width: 36px;
            height: 36px;
            background: rgba(255,255,255,.2);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 15px;
            color: #fff;
            flex-shrink: 0;
        }

        .user-info {
            flex: 1;
            overflow: hidden;
        }

        .user-name {
            font-size: .83rem;
            font-weight: 600;
            color: #fff;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .user-role {
            font-size: .72rem;
            color: rgba(255,255,255,.5);
        }

        .btn-signout {
            background: none;
            border: none;
            color: rgba(255,255,255,.5);
            font-size: 16px;
            cursor: pointer;
            padding: 2px;
            transition: color .2s;
            text-decoration: none;
        }

            .btn-signout:hover {
                color: #e94560;
            }

        /* Main */
        .main-content {
            margin-left: 240px;
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .topbar {
            background: #fff;
            padding: 0 1.75rem;
            height: 64px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 1px 4px rgba(0,0,0,.08);
            position: sticky;
            top: 0;
            z-index: 90;
        }

        .topbar-title h2 {
            font-size: 1.1rem;
            font-weight: 700;
            color: #1a1a2e;
        }

        .topbar-title p {
            font-size: .78rem;
            color: #999;
            margin-top: 1px;
        }

        .btn-new {
            background: linear-gradient(135deg,#0f3460,#533483);
            color: #fff;
            border: none;
            border-radius: 8px;
            padding: .45rem 1.1rem;
            font-size: .85rem;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            transition: opacity .2s;
        }

            .btn-new:hover {
                opacity: .88;
                color: #fff;
            }

        .page-body {
            padding: 1.75rem;
            flex: 1;
        }

        /* Filter bar */
        .filter-bar {
            background: #fff;
            border-radius: 12px;
            padding: 1rem 1.25rem;
            margin-bottom: 1.25rem;
            box-shadow: 0 2px 8px rgba(0,0,0,.06);
            display: flex;
            align-items: center;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .filter-tabs {
            display: flex;
            gap: .4rem;
            flex-wrap: wrap;
        }

        .filter-tab {
            padding: .35rem .85rem;
            border-radius: 20px;
            font-size: .78rem;
            font-weight: 600;
            border: 1.5px solid #e0e0e0;
            background: #fff;
            color: #666;
            cursor: pointer;
            text-decoration: none;
            transition: all .2s;
        }

            .filter-tab:hover {
                border-color: #533483;
                color: #533483;
            }

            .filter-tab.active {
                background: linear-gradient(135deg,#0f3460,#533483);
                color: #fff;
                border-color: transparent;
            }

        .search-box {
            margin-left: auto;
            display: flex;
            gap: .5rem;
        }

            .search-box input {
                border: 1.5px solid #e0e0e0;
                border-radius: 8px;
                padding: .4rem .85rem;
                font-size: .85rem;
                outline: none;
                transition: border-color .2s;
            }

                .search-box input:focus {
                    border-color: #0f3460;
                }

            .search-box button {
                background: #0f3460;
                color: #fff;
                border: none;
                border-radius: 8px;
                padding: .4rem .85rem;
                font-size: .82rem;
                font-weight: 600;
                cursor: pointer;
            }

        /* Table card */
        .section-card {
            background: #fff;
            border-radius: 14px;
            box-shadow: 0 2px 8px rgba(0,0,0,.06);
            overflow: hidden;
        }

        .section-header {
            padding: 1rem 1.4rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid #f0f0f0;
        }

            .section-header h3 {
                font-size: .95rem;
                font-weight: 700;
                color: #1a1a2e;
            }

        .result-count {
            font-size: .8rem;
            color: #aaa;
        }

        .cases-table {
            width: 100%;
            border-collapse: collapse;
        }

            .cases-table thead th {
                padding: .7rem 1.2rem;
                font-size: .7rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: .6px;
                color: #aaa;
                background: #fafafa;
                border-bottom: 1px solid #f0f0f0;
                text-align: left;
                white-space: nowrap;
            }

            .cases-table tbody tr {
                border-bottom: 1px solid #f8f8f8;
                transition: background .15s;
            }

                .cases-table tbody tr:last-child {
                    border-bottom: none;
                }

                .cases-table tbody tr:hover {
                    background: #fafbff;
                }

            .cases-table tbody td {
                padding: .8rem 1.2rem;
                font-size: .85rem;
                color: #444;
                vertical-align: middle;
            }

        .case-number {
            font-weight: 700;
            color: #0f3460;
            font-size: .78rem;
            font-family: monospace;
        }

        .case-title-link {
            font-weight: 500;
            color: #222;
            text-decoration: none;
            max-width: 230px;
            display: block;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

            .case-title-link:hover {
                color: #533483;
                text-decoration: underline;
            }

        /* Badges */
        .badge-priority {
            display: inline-block;
            padding: .22rem .6rem;
            border-radius: 20px;
            font-size: .7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .4px;
        }

            .badge-priority.Critical {
                background: #fde8ec;
                color: #c0152a;
            }

            .badge-priority.High {
                background: #fff3e0;
                color: #e65100;
            }

            .badge-priority.Medium {
                background: #e8f5e9;
                color: #2e7d32;
            }

            .badge-priority.Low {
                background: #e8f0fe;
                color: #1565c0;
            }

        .badge-status {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: .22rem .6rem;
            border-radius: 20px;
            font-size: .7rem;
            font-weight: 600;
        }

            .badge-status::before {
                content: '';
                width: 6px;
                height: 6px;
                border-radius: 50%;
                background: currentColor;
                flex-shrink: 0;
            }

            .badge-status.New {
                background: #e8f0fe;
                color: #1565c0;
            }

            .badge-status.Assigned {
                background: #f3e5f5;
                color: #6a1b9a;
            }

            .badge-status.In-Progress {
                background: #fff8e1;
                color: #f57f17;
            }

            .badge-status.Pending {
                background: #fce4ec;
                color: #880e4f;
            }

            .badge-status.Escalated {
                background: #fde8ec;
                color: #c0152a;
            }

            .badge-status.Resolved {
                background: #e6f9f1;
                color: #1b5e20;
            }

            .badge-status.Closed {
                background: #f5f5f5;
                color: #757575;
            }

            .badge-status.Cancelled {
                background: #f5f5f5;
                color: #9e9e9e;
            }

        .owner-cell {
            font-size: .82rem;
            color: #666;
        }

        .unassigned {
            color: #bbb;
            font-style: italic;
        }

        .time-cell {
            font-size: .76rem;
            color: #bbb;
            white-space: nowrap;
        }

        .empty-state {
            padding: 3rem;
            text-align: center;
            color: #bbb;
        }

            .empty-state p {
                margin-top: .5rem;
                font-size: .85rem;
            }

        /* Alerts */
        .alert {
            border-radius: 10px;
            padding: .75rem 1.1rem;
            margin-bottom: 1.1rem;
            font-size: .85rem;
            font-weight: 500;
        }

        .alert-success {
            background: #e6f9f1;
            border: 1px solid #bfe8d4;
            color: #1b5e20;
        }

        .alert-danger {
            background: #fde8ec;
            border: 1px solid #f5c2cb;
            color: #c0152a;
        }

        /* Row actions */
        .row-actions {
            display: flex;
            gap: .4rem;
            white-space: nowrap;
        }

        .btn-action {
            border: none;
            border-radius: 7px;
            padding: .3rem .7rem;
            font-size: .74rem;
            font-weight: 700;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
            transition: opacity .2s;
        }

            .btn-action:hover {
                opacity: .85;
            }

        .btn-edit {
            background: #e8f0fe;
            color: #1565c0;
        }

        .btn-delete {
            background: #fde8ec;
            color: #c0152a;
        }
    </style>
</head>
<body>

    <!-- Sidebar -->
    <aside class="sidebar">
        <div class="sidebar-brand">
            <div class="brand-icon">&#128187;</div>
            <span>IT Support</span>
        </div>
        <ul class="sidebar-nav">
            <li class="nav-section-label">Main Menu</li>
            <li><a href="@Url.Action("Index","Dashboard")"><span class="nav-icon">&#9636;</span> Dashboard</a></li>
            <li><a href="@Url.Action("Index","Cases")" class="active"><span class="nav-icon">&#128203;</span> All Cases</a></li>
            <li><a href="@Url.Action("Create","Cases")"><span class="nav-icon">&#43;</span> New Case</a></li>
            <li class="nav-section-label" style="margin-top:.5rem">Management</li>
            <li><a href="@Url.Action("Index","Customers")"><span class="nav-icon">&#128100;</span> Customers</a></li>
            <li><a href="@Url.Action("Index","Engineers")"><span class="nav-icon">&#128736;</span> Engineers</a></li>
            <li><a href="#"><span class="nav-icon">&#128202;</span> Reports</a></li>
            <li class="nav-section-label" style="margin-top:.5rem">Settings</li>
            <li><a href="@Url.Action("Index","Configuration")"><span class="nav-icon">&#9881;</span> Configuration</a></li>
        </ul>
        <div class="sidebar-footer">
            <div class="user-pill">
                <div class="user-avatar">&#128100;</div>
                <div class="user-info">
                    <div class="user-name">@ViewBag.Username</div>
                    <div class="user-role">@ViewBag.Role</div>
                </div>
                <a href="@Url.Action("SignOut","Dashboard")" class="btn-signout" title="Sign out">&#8594;</a>
            </div>
        </div>
    </aside>

    <!-- Main -->
    <div class="main-content">
        <header class="topbar">
            <div class="topbar-title">
                <h2>All Cases</h2>
                <p>@Model.Count case(s) found</p>
            </div>
            <div>
                <a href="@Url.Action("Create","Cases")" class="btn-new">&#43; New Case</a>
            </div>
        </header>

        <div class="page-body">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">&#10003; @TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">&#9888; @TempData["Error"]</div>
            }

            <!-- Filter bar -->
            <form method="get" action="@Url.Action("Index","Cases")">
                <div class="filter-bar">
                    <div class="filter-tabs">
                        <a href="@Url.Action("Index","Cases")"
                           class="filter-tab @(activeStatus == null && string.IsNullOrEmpty(search) ? "active" : "")">All</a>
                        @if (statuses != null)
                        {
                            foreach (var s in statuses)
                            {
                                <a href="@Url.Action("Index","Cases", new { statusId = s.StatusId, search })"
                                   class="filter-tab @(activeStatus == s.StatusId ? "active" : "")">
                                    @s.StatusName
                                </a>
                            }
                        }
                    </div>
                    <div class="search-box">
                        <input type="hidden" name="statusId" value="@(activeStatus.HasValue ? activeStatus.ToString() : "")" />
                        <input type="text" name="search" value="@search" placeholder="Search cases..." />
                        <button type="submit">Search</button>
                    </div>
                </div>
            </form>

            <!-- Cases Table -->
            <div class="section-card">
                <div class="section-header">
                    <h3>Cases</h3>
                    <span class="result-count">@Model.Count result(s)</span>
                </div>
                @if (Model.Count == 0)
                {
                    <div class="empty-state">
                        <div style="font-size:2rem">&#128203;</div>
                        <p>No cases found matching your criteria.</p>
                    </div>
                }
                else
                {
                    <table class="cases-table">
                        <thead>
                            <tr>
                                <th>Case #</th>
                                <th>Title</th>
                                <th>Priority</th>
                                <th>Application</th>                      
                                <th>Status</th>
                                <th>Customer</th>
                                <th>Owner</th>
                                <th>Program</th>
                                <th>Opened</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model)
                            {
                                string statusClass = c.StatusName.Replace(" ", "-");
                                <tr>
                                    <td><span class="case-number">@c.CaseNumber</span></td>
                                    <td>
                                        <a href="@Url.Action("Details","Cases", new { id = c.CaseId })"
                                           class="case-title-link" title="@c.Title">@c.Title</a>
                                    </td>
                                    <td><span class="badge-priority @c.PriorityName">@c.PriorityName</span></td>
                                    <td>@c.Application</td> 
                                    <td><span class="badge-status @statusClass">@c.StatusName</span></td>
                                    <td>@c.ContactName</td>
                                    <td>
                                        @if (string.IsNullOrEmpty(c.OwnerName))
                                        {<span class="unassigned">Unassigned</span> }
                                        else
                                        { <span class="owner-cell">@c.OwnerName</span>}
                                    </td>
                                    <td style="font-size:.78rem;color:#888">@c.ProgramName</td>
                                    <td><span class="time-cell">@c.CreatedAt.ToString("MMM dd, yyyy")</span></td>
                                    <td>
                                        <div class="row-actions">
                                            <a href="@Url.Action("Edit","Cases", new { id = c.CaseId })" class="btn-action btn-edit">Edit</a>
                                            @using (Html.BeginForm("Delete", "Cases", new { id = c.CaseId }, FormMethod.Post))
                                            {
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn-action btn-delete"
                                                        onclick="return confirm('Are you sure you want to delete case @c.CaseNumber?');">
                                                    Delete
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
</body>
</html>
