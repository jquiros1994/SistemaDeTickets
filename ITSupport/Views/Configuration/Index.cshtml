@model ITSupport.Models.User
@{
    Layout = null;
    ViewBag.Title = "Configuration";
    var errors = ViewBag.Errors as List<string>;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>IT Support — Configuration</title>
    @Styles.Render("~/Content/css")
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Segoe UI',Tahoma,Geneva,Verdana,sans-serif;
            background: #f0f2f5;
            display: flex;
            min-height: 100vh;
            color: #333;
        }

        /* Sidebar */
        .sidebar {
            width: 240px;
            min-height: 100vh;
            background: linear-gradient(180deg,#0f3460 0%,#533483 100%);
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 100;
        }

        .sidebar-brand {
            padding: 1.5rem 1.25rem;
            border-bottom: 1px solid rgba(255,255,255,.1);
        }

            .sidebar-brand .brand-icon {
                width: 40px;
                height: 40px;
                background: rgba(255,255,255,.15);
                border-radius: 10px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 18px;
                margin-right: .5rem;
                vertical-align: middle;
            }

            .sidebar-brand span {
                color: #fff;
                font-size: 1rem;
                font-weight: 700;
                vertical-align: middle;
            }

        .sidebar-nav {
            flex: 1;
            padding: 1rem 0;
            list-style: none;
        }

        .nav-section-label {
            padding: .75rem 1.25rem .35rem;
            font-size: .68rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: rgba(255,255,255,.4);
        }

        .sidebar-nav a {
            display: flex;
            align-items: center;
            gap: .75rem;
            padding: .65rem 1.25rem;
            color: rgba(255,255,255,.75);
            text-decoration: none;
            font-size: .88rem;
            font-weight: 500;
            border-left: 3px solid transparent;
            transition: all .2s;
        }

            .sidebar-nav a:hover, .sidebar-nav a.active {
                background: rgba(255,255,255,.1);
                color: #fff;
                border-left-color: #e94560;
            }

        .nav-icon {
            font-size: 16px;
            width: 20px;
            text-align: center;
        }

        .sidebar-footer {
            padding: 1rem 1.25rem;
            border-top: 1px solid rgba(255,255,255,.1);
        }

        .user-pill {
            display: flex;
            align-items: center;
            gap: .65rem;
        }

        .user-avatar {
            width: 36px;
            height: 36px;
            background: rgba(255,255,255,.2);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 15px;
            color: #fff;
            flex-shrink: 0;
        }

        .user-info {
            flex: 1;
            overflow: hidden;
        }

        .user-name {
            font-size: .83rem;
            font-weight: 600;
            color: #fff;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .user-role {
            font-size: .72rem;
            color: rgba(255,255,255,.5);
        }

        .btn-signout {
            background: none;
            border: none;
            color: rgba(255,255,255,.5);
            font-size: 16px;
            cursor: pointer;
            padding: 2px;
            transition: color .2s;
            text-decoration: none;
        }

            .btn-signout:hover {
                color: #e94560;
            }

        /* Main */
        .main-content {
            margin-left: 240px;
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .topbar {
            background: #fff;
            padding: 0 1.75rem;
            height: 64px;
            display: flex;
            align-items: center;
            box-shadow: 0 1px 4px rgba(0,0,0,.08);
            position: sticky;
            top: 0;
            z-index: 90;
        }

        .topbar-title h2 {
            font-size: 1.1rem;
            font-weight: 700;
            color: #1a1a2e;
        }

        .topbar-title p {
            font-size: .78rem;
            color: #999;
            margin-top: 1px;
        }

        .page-body {
            padding: 1.75rem;
            max-width: 780px;
        }

        /* Alerts */
        .alert {
            border-radius: 10px;
            padding: .75rem 1.1rem;
            margin-bottom: 1.1rem;
            font-size: .85rem;
            font-weight: 500;
        }

        .alert-success {
            background: #e6f9f1;
            border: 1px solid #bfe8d4;
            color: #1b5e20;
        }

        .alert-error {
            background: #fde8ec;
            border: 1px solid #f5c2cb;
            color: #c0152a;
            border-radius: 10px;
            padding: .8rem 1.1rem;
            margin-bottom: 1.1rem;
            font-size: .85rem;
        }

            .alert-error ul {
                margin: .25rem 0 0 1.1rem;
            }

        /* Overview card */
        .overview-card {
            background: #fff;
            border-radius: 14px;
            box-shadow: 0 2px 8px rgba(0,0,0,.06);
            padding: 1.5rem;
            display: flex;
            align-items: center;
            gap: 1.1rem;
            margin-bottom: 1.1rem;
        }

        .overview-avatar {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            background: linear-gradient(135deg,#0f3460,#533483);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            flex-shrink: 0;
        }

        .overview-username {
            font-size: 1.05rem;
            font-weight: 700;
            color: #1a1a2e;
        }

        .overview-password {
            font-size: .85rem;
            color: #999;
            margin-top: 2px;
            letter-spacing: 2px;
        }

        /* Form card */
        .form-card {
            background: #fff;
            border-radius: 14px;
            box-shadow: 0 2px 8px rgba(0,0,0,.06);
            overflow: hidden;
        }

        .form-card-header {
            padding: 1rem 1.5rem;
            border-bottom: 1px solid #f0f0f0;
        }

            .form-card-header h3 {
                font-size: .95rem;
                font-weight: 700;
                color: #1a1a2e;
            }

            .form-card-header p {
                font-size: .78rem;
                color: #999;
                margin-top: 2px;
            }

        .form-card-body {
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
            gap: 1.1rem;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: .35rem;
        }

            .form-group.full {
                grid-column: span 2;
            }

        label {
            font-size: .75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .5px;
            color: #666;
        }

        .form-control {
            border: 1.5px solid #e0e0e0;
            border-radius: 8px;
            padding: .5rem .85rem;
            font-size: .88rem;
            color: #333;
            outline: none;
            transition: border-color .2s;
            width: 100%;
            font-family: inherit;
        }

            .form-control:focus {
                border-color: #0f3460;
                box-shadow: 0 0 0 3px rgba(15,52,96,.1);
            }

        .form-hint {
            font-size: .76rem;
            color: #aaa;
        }

        .form-divider {
            border-top: 1px solid #f0f0f0;
            padding-top: 1.1rem;
        }

        .form-footer {
            padding: 1rem 1.5rem;
            border-top: 1px solid #f0f0f0;
            display: flex;
            align-items: center;
            justify-content: flex-end;
        }

        .btn-submit {
            background: linear-gradient(135deg,#0f3460,#533483);
            color: #fff;
            border: none;
            border-radius: 8px;
            padding: .5rem 1.4rem;
            font-size: .88rem;
            font-weight: 600;
            cursor: pointer;
            transition: opacity .2s;
        }

            .btn-submit:hover {
                opacity: .88;
            }
    </style>
</head>
<body>

    <!-- Sidebar -->
    <aside class="sidebar">
        <div class="sidebar-brand">
            <div class="brand-icon">&#128187;</div>
            <span>IT Support</span>
        </div>
        <ul class="sidebar-nav">
            <li class="nav-section-label">Main Menu</li>
            <li><a href="@Url.Action("Index","Dashboard")"><span class="nav-icon">&#9636;</span> Dashboard</a></li>
            <li><a href="@Url.Action("Index","Cases")"><span class="nav-icon">&#128203;</span> All Cases</a></li>
            <li><a href="@Url.Action("Create","Cases")"><span class="nav-icon">&#43;</span> New Case</a></li>
            <li class="nav-section-label" style="margin-top:.5rem">Management</li>
            <li><a href="@Url.Action("Index","Customers")"><span class="nav-icon">&#128100;</span> Customers</a></li>
            <li><a href="@Url.Action("Index","Engineers")"><span class="nav-icon">&#128736;</span> Engineers</a></li>
            <li><a href="@Url.Action("Index","Reports")"><span class="nav-icon">&#128202;</span> Reports</a></li>
            <li class="nav-section-label" style="margin-top:.5rem">Settings</li>
            <li><a href="@Url.Action("Index","Configuration")" class="active"><span class="nav-icon">&#9881;</span> Configuration</a></li>
        </ul>
        <div class="sidebar-footer">
            <div class="user-pill">
                <div class="user-avatar">&#128100;</div>
                <div class="user-info">
                    <div class="user-name">@ViewBag.Username</div>
                    <div class="user-role">@ViewBag.Role</div>
                </div>
                <a href="@Url.Action("SignOut","Dashboard")" class="btn-signout" title="Sign out">&#8594;</a>
            </div>
        </div>
    </aside>

    <!-- Main -->
    <div class="main-content">
        <header class="topbar">
            <div class="topbar-title">
                <h2>Configuration</h2>
                <p>Manage your account details</p>
            </div>
        </header>

        <div class="page-body">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">&#10003; @TempData["Success"]</div>
            }

            @if (errors != null && errors.Count > 0)
            {
                <div class="alert-error">
                    <strong>Please fix the following:</strong>
                    <ul>
                        @foreach (var e in errors)
                        {
                            <li>@e</li>
                        }
                    </ul>
                </div>
            }

            <!-- Account overview -->
            <div class="overview-card">
                <div class="overview-avatar">&#128100;</div>
                <div>
                    <div class="overview-username">@Model.Username</div>
                    <div class="overview-password">&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;</div>
                </div>
            </div>

            <!-- Update form -->
            @using (Html.BeginForm("Index", "Configuration", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="form-card">
                    <div class="form-card-header">
                        <h3>Account Settings</h3>
                        <p>Update your name, email, or password</p>
                    </div>
                    <div class="form-card-body">

                        <div class="form-row">
                            <div class="form-group">
                                <label>Name *</label>
                                <input type="text" name="username" class="form-control" value="@Model.Username" required />
                            </div>
                            <div class="form-group">
                                <label>Email *</label>
                                <input type="email" name="email" class="form-control" value="@Model.Email" required />
                            </div>
                        </div>

                        <div class="form-row form-divider">
                            <div class="form-group">
                                <label>New Password</label>
                                <input type="password" name="newPassword" class="form-control" placeholder="Leave blank to keep current password" />
                            </div>
                            <div class="form-group">
                                <label>Confirm New Password</label>
                                <input type="password" name="confirmPassword" class="form-control" placeholder="Re-enter new password" />
                            </div>
                            <div class="form-group full">
                                <span class="form-hint">Password must be at least 8 characters. Leave both fields blank to keep your current password.</span>
                            </div>
                        </div>

                    </div>
                    <div class="form-footer">
                        <button type="submit" class="btn-submit">Save Changes</button>
                    </div>
                </div>
            }
        </div>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
</body>
</html>
