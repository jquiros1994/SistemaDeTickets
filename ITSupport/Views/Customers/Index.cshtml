@model List<ITSupport.Models.Customer>
@{
    Layout = null;
    ViewBag.Title = "Customers";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>IT Support — Customers</title>
    @Styles.Render("~/Content/css")
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #f0f2f5;
            display: flex;
            min-height: 100vh;
            color: #333;
        }

        /* Sidebar */
        .sidebar {
            width: 240px;
            min-height: 100vh;
            background: linear-gradient(180deg,#0f3460 0%,#533483 100%);
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 100;
        }

        .sidebar-brand {
            padding: 1.5rem 1.25rem;
            border-bottom: 1px solid rgba(255,255,255,.1);
        }

            .sidebar-brand .brand-icon {
                width: 40px;
                height: 40px;
                background: rgba(255,255,255,.15);
                border-radius: 10px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 18px;
                margin-right: .5rem;
                vertical-align: middle;
            }

            .sidebar-brand span {
                color: #fff;
                font-size: 1rem;
                font-weight: 700;
                vertical-align: middle;
            }

        .sidebar-nav {
            flex: 1;
            padding: 1rem 0;
            list-style: none;
        }

        .nav-section-label {
            padding: .75rem 1.25rem .35rem;
            font-size: .68rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: rgba(255,255,255,.4);
        }

        .sidebar-nav a {
            display: flex;
            align-items: center;
            gap: .75rem;
            padding: .65rem 1.25rem;
            color: rgba(255,255,255,.75);
            text-decoration: none;
            font-size: .88rem;
            font-weight: 500;
            border-left: 3px solid transparent;
            transition: all .2s;
        }

            .sidebar-nav a:hover, .sidebar-nav a.active {
                background: rgba(255,255,255,.1);
                color: #fff;
                border-left-color: #e94560;
            }

        .nav-icon {
            font-size: 16px;
            width: 20px;
            text-align: center;
        }

        .sidebar-footer {
            padding: 1rem 1.25rem;
            border-top: 1px solid rgba(255,255,255,.1);
        }

        .user-pill {
            display: flex;
            align-items: center;
            gap: .65rem;
        }

        .user-avatar {
            width: 36px;
            height: 36px;
            background: rgba(255,255,255,.2);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 15px;
            color: #fff;
            flex-shrink: 0;
        }

        .user-info {
            flex: 1;
            overflow: hidden;
        }

        .user-name {
            font-size: .83rem;
            font-weight: 600;
            color: #fff;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .user-role {
            font-size: .72rem;
            color: rgba(255,255,255,.5);
        }

        .btn-signout {
            background: none;
            border: none;
            color: rgba(255,255,255,.5);
            font-size: 16px;
            cursor: pointer;
            padding: 2px;
            transition: color .2s;
            text-decoration: none;
        }

            .btn-signout:hover {
                color: #e94560;
            }

        /* Main */
        .main-content {
            margin-left: 240px;
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .topbar {
            background: #fff;
            padding: 0 1.75rem;
            height: 64px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 1px 4px rgba(0,0,0,.08);
            position: sticky;
            top: 0;
            z-index: 90;
        }

        .topbar-title h2 {
            font-size: 1.1rem;
            font-weight: 700;
            color: #1a1a2e;
        }

        .topbar-title p {
            font-size: .78rem;
            color: #999;
            margin-top: 1px;
        }

        .btn-new {
            background: linear-gradient(135deg,#0f3460,#533483);
            color: #fff;
            border: none;
            border-radius: 8px;
            padding: .45rem 1.1rem;
            font-size: .85rem;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            transition: opacity .2s;
        }

            .btn-new:hover {
                opacity: .88;
                color: #fff;
            }

        .page-body {
            padding: 1.75rem;
            flex: 1;
        }

        /* Table card */
        .section-card {
            background: #fff;
            border-radius: 14px;
            box-shadow: 0 2px 8px rgba(0,0,0,.06);
            overflow: hidden;
        }

        .section-header {
            padding: 1rem 1.4rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid #f0f0f0;
        }

            .section-header h3 {
                font-size: .95rem;
                font-weight: 700;
                color: #1a1a2e;
            }

        .result-count {
            font-size: .8rem;
            color: #aaa;
        }

        .customers-table {
            width: 100%;
            border-collapse: collapse;
        }

            .customers-table thead th {
                padding: .7rem 1.2rem;
                font-size: .7rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: .6px;
                color: #aaa;
                background: #fafafa;
                border-bottom: 1px solid #f0f0f0;
                text-align: left;
                white-space: nowrap;
            }

            .customers-table tbody tr {
                border-bottom: 1px solid #f8f8f8;
                transition: background .15s;
            }

                .customers-table tbody tr:last-child {
                    border-bottom: none;
                }

                .customers-table tbody tr:hover {
                    background: #fafbff;
                }

            .customers-table tbody td {
                padding: .8rem 1.2rem;
                font-size: .85rem;
                color: #444;
                vertical-align: middle;
            }

        .customer-name {
            font-weight: 600;
            color: #222;
        }

        .badge-status {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: .22rem .6rem;
            border-radius: 20px;
            font-size: .7rem;
            font-weight: 600;
        }

            .badge-status::before {
                content: '';
                width: 6px;
                height: 6px;
                border-radius: 50%;
                background: currentColor;
                flex-shrink: 0;
            }

            .badge-status.Active {
                background: #e6f9f1;
                color: #1b5e20;
            }

            .badge-status.Inactive {
                background: #f5f5f5;
                color: #9e9e9e;
            }

        .time-cell {
            font-size: .76rem;
            color: #bbb;
            white-space: nowrap;
        }

        .empty-state {
            padding: 3rem;
            text-align: center;
            color: #bbb;
        }

            .empty-state p {
                margin-top: .5rem;
                font-size: .85rem;
            }

        /* Alerts */
        .alert {
            border-radius: 10px;
            padding: .75rem 1.1rem;
            margin-bottom: 1.1rem;
            font-size: .85rem;
            font-weight: 500;
        }

        .alert-success {
            background: #e6f9f1;
            border: 1px solid #bfe8d4;
            color: #1b5e20;
        }

        .alert-danger {
            background: #fde8ec;
            border: 1px solid #f5c2cb;
            color: #c0152a;
        }
    </style>
</head>
<body>

    <!-- Sidebar -->
    <aside class="sidebar">
        <div class="sidebar-brand">
            <div class="brand-icon">&#128187;</div>
            <span>IT Support</span>
        </div>
        <ul class="sidebar-nav">
            <li class="nav-section-label">Main Menu</li>
            <li><a href="@Url.Action("Index","Dashboard")"><span class="nav-icon">&#9636;</span> Dashboard</a></li>
            <li><a href="@Url.Action("Index","Cases")"><span class="nav-icon">&#128203;</span> All Cases</a></li>
            <li><a href="@Url.Action("Create","Cases")"><span class="nav-icon">&#43;</span> New Case</a></li>
            <li class="nav-section-label" style="margin-top:.5rem">Management</li>
            <li><a href="@Url.Action("Index","Customers")" class="active"><span class="nav-icon">&#128100;</span> Customers</a></li>
            <li><a href="#"><span class="nav-icon">&#128736;</span> Engineers</a></li>
            <li><a href="#"><span class="nav-icon">&#128202;</span> Reports</a></li>
            <li class="nav-section-label" style="margin-top:.5rem">Settings</li>
            <li><a href="#"><span class="nav-icon">&#9881;</span> Configuration</a></li>
        </ul>
        <div class="sidebar-footer">
            <div class="user-pill">
                <div class="user-avatar">&#128100;</div>
                <div class="user-info">
                    <div class="user-name">@ViewBag.Username</div>
                    <div class="user-role">@ViewBag.Role</div>
                </div>
                <a href="@Url.Action("SignOut","Dashboard")" class="btn-signout" title="Sign out">&#8594;</a>
            </div>
        </div>
    </aside>

    <!-- Main -->
    <div class="main-content">
        <header class="topbar">
            <div class="topbar-title">
                <h2>Customers</h2>
                <p>@Model.Count customer(s) found</p>
            </div>
            <div>
                <a href="@Url.Action("Create","Customers")" class="btn-new">&#43; New Customer</a>
            </div>
        </header>

        <div class="page-body">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">&#10003; @TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">&#9888; @TempData["Error"]</div>
            }

            <!-- Customers Table -->
            <div class="section-card">
                <div class="section-header">
                    <h3>All Customers</h3>
                    <span class="result-count">@Model.Count result(s)</span>
                </div>
                @if (Model.Count == 0)
                {
                    <div class="empty-state">
                        <div style="font-size:2rem">&#128100;</div>
                        <p>No customers found yet.</p>
                    </div>
                }
                else
                {
                    <table class="customers-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Country</th>
                                <th>Status</th>
                                <th>Created</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model)
                            {
                                <tr>
                                    <td><span class="customer-name">@c.FullName</span></td>
                                    <td>@c.Email</td>
                                    <td>@(string.IsNullOrEmpty(c.PhoneNumber) ? "—" : c.PhoneNumber)</td>
                                    <td>@c.Country</td>
                                    <td>
                                        @if (c.IsActive)
                                        { <span class="badge-status Active">Active</span> }
                                        else
                                        { <span class="badge-status Inactive">Inactive</span> }
                                    </td>
                                    <td><span class="time-cell">@c.CreatedAt.ToString("MMM dd, yyyy")</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
</body>
</html>
